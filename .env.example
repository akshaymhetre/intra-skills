# Copy to .env next to docker-compose.yml, then edit.

# The address people and agents use. Every command the registry prints is built from it.
INTRA_SKILLS_PUBLIC_URL=https://skills.example.com

# With `docker compose --profile https`: the host name Caddy fetches a certificate for.
INTRA_SKILLS_DOMAIN=skills.example.com

# Optional: shown in the console's wordmark and used as the Claude Code marketplace name.
# Leave it empty to choose the name in the setup wizard and change it later on the Registry page;
# a value here locks it.
INTRA_SKILLS_ORG_NAME=

# Optional: 32 random bytes in base64 (openssl rand -base64 32). Encrypts stored git credentials.
# Leave empty and the server creates /data/secret.key on first start instead.
INTRA_SKILLS_SECRET_KEY=

# Optional: set to 0.0.0.0 to expose port 7710 directly, when your own proxy runs on another machine.
# INTRA_SKILLS_BIND=127.0.0.1
